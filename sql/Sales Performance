select * from orders;

select sum(total_amount) as Total_revenue from orders;

select count(order_id) as Total_order from orders;

select Avg(total_amount) as Average_order_value from orders;

select year(order_date) as sales_year, monthname(order_date)as sales_month,
sum(total_amount) as total_revenue from orders
group by year(order_date),monthname(order_date)
order by total_revenue desc
limit 1;

select year(order_date)as sales_year,monthname(order_date)as sales_month,
sum(total_amount)as total_revenue from orders
group by year(order_date),month(order_date),monthname(order_date)
order by year(order_date),month(order_date);

select c.city,sum(o.total_amount)as total_revenue from customer c join orders o on c.customer_id=o.customer_id
group by c.city
order by total_revenue desc;

select c.membership_type,sum(o.total_amount) as total_revenue from customer c join orders o on c.customer_id=o.customer_id
group by c.membership_type
order by total_revenue desc;

select min(total_amount)as lowest_order_value from orders;

select count(payment_method) as total_transactions,payment_method from payments
group by payment_method
order by total_transactions desc;

select round(avg(customer_total),2) as average_revenue_per_customer from(select customer_id,sum(total_amount) as 
customer_total from orders group by customer_id) as customer_revenue;


