select order_status, count(order_id) as total_orders from orders
group by order_status
order by total_orders desc;

select c.customer_name,count(o.order_id) as total_orders from customer c
join orders o on c.customer_id =o.customer_id 
group by c.customer_name
order by total_orders desc;

select round(avg(total_items),2) as average_items_per_order from (select order_id,sum(quantity) as total_items from order_items
group by order_id) as order_summary;

select order_id,sum(quantity) as total_items from order_items
group by order_id
order by total_items desc
limit 1;

select year(order_date) as order_year,monthname(order_date) as order_month, count(order_id) as total_orders from orders
group by year(order_date),month(order_date),monthname(order_date)
order by total_orders desc;

select c.city,count(o.order_id)as total_orders from customer c join orders o on c.customer_id=o.customer_id
group by c.city
order by total_orders desc;

select c.membership_type,count(o.order_id) as total_orders from customer c join orders o on c.customer_id=o.customer_id
group by c.membership_type
order by total_orders desc;

select payment_method,count(payment_id) as total_transactions from payments
group by payment_method
order by total_transactions desc;

select order_id,total_amount from orders
order by total_amount desc
limit 10;

select order_id,total_amount from orders 
where total_amount>(select avg(total_amount) from orders)
order by total_amount desc;

select c.customer_name,o.order_id,o.total_amount from customer c join orders o on c.customer_id=o.customer_id
order by o.total_amount desc
limit 1;

select c.membership_type,round(avg(o.total_amount),2) as average_order_value from customer c join orders o on c.customer_id=o.customer_id
group by c.membership_type
order by average_order_value desc;

