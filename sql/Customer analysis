create database customer_insights;

select * from Customer;

select count(customer_id) from customer;

select count(customer_id) as Number_of_customer,city from customer
group by city;

select count(customer_id) as Number_of_customer,state from customer
group by state;

select count(customer_id) as Number_of_customer,membership_type from customer
group by membership_type;

select count(customer_id) as Number_of_customer, gender from customer
group by gender;

select avg(age) as Avg_age from customer;

select Count(customer_name) as Total_customer,Occupation from customer
group by occupation;

select max(annual_income) as highest_income from customer;

select min(annual_income) as lowest_income from customer;

select avg(annual_income) as Average_income from customer;

select year(join_date)as year,month(join_date)as month,count(customer_id)as new_customers from customer
group by year(join_date),month(join_date)
order by year(join_date),month(join_date);

select count(customer_id) as Total_customer, City from customer
group by city
order by total_customer desc;




